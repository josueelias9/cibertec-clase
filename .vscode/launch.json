    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Flask",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/josue3/anaconda3/envs/flask_counter/bin/python",
            "cwd": "${workspaceFolder}/flask",
            "module": "flask",
            "env": {
                "FLASK_APP": "flaskr",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "autoStartBrowser": false
        }
    ]
}